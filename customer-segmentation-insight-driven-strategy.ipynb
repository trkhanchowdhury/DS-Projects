    "radar_cols = [\n",
    "    'Age_Mean', \n",
    "    'Purchase_Amount_Mean', \n",
    "    'Frequency_of_Purchase_Mean',\n",
    "    'Brand_Loyalty_Mean', \n",
    "    'Loyalty_Member_Pct'\n",
    "]\n",
    "scaled_values = scaler.fit_transform(cluster_summary[radar_cols])\n",
    "\n",
    "categories = radar_cols\n",
    "N = len(categories)\n",
    "\n",
    "angles = np.linspace(0, 2 * np.pi, N, endpoint=False).tolist()\n",
    "angles += angles[:1]\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(7,7), subplot_kw=dict(polar=True))\n",
    "\n",
    "for i, row in cluster_summary.iterrows():\n",
    "    values = scaled_values[i].tolist()\n",
    "    values += values[:1]\n",
    "    ax.plot(angles, values, label=f\"Cluster {int(row['Cluster'])}\")\n",
    "    ax.fill(angles, values, alpha=0.1)\n",
    "\n",
    "ax.set_xticks(angles[:-1])\n",
    "ax.set_xticklabels(categories)\n",
    "ax.set_yticklabels([])\n",
    "\n",
    "plt.title(\"Radar Chart - Cluster Comparison\", size=15, pad=20)\n",
    "plt.legend(loc='upper right', bbox_to_anchor=(1.3, 1.1))\n",
    "plt.show()"
   ]
