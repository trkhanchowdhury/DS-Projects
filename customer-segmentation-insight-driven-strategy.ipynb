    "        .value_counts()\n",
    "        .head(5)\n",
    "        .reset_index()\n",
    "    )\n",
    "    top5.columns = ['Purchase_Category', 'Count']\n",
    "    \n",
    "    sns.barplot(\n",
    "        data=top5,\n",
    "        x='Count',\n",
    "        y='Purchase_Category',\n",
    "        ax=ax,\n",
    "        palette='viridis'\n",
    "    )\n",
    "    \n",
    "    ax.set_title(f'Cluster {cl} - Top 5 Purchase Categories', fontsize=12)\n",
    "    ax.set_xlabel('Purchase Ammount')\n",
    "    ax.set_ylabel('Category')\n",
    "    \n",
    "for j in range(i+1, len(axes)):\n",
    "    fig.delaxes(axes[j])\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
