   "source": [
    "e_com_encoded = e_com_scaled.copy()\n",
    "\n",
    "e_com_encoded['Customer_Loyalty_Program_Member'] = e_com_encoded['Customer_Loyalty_Program_Member'].astype(int)\n",
    "\n",
    "ordinal_cols = ['Social_Media_Influence', 'Engagement_with_Ads',\n",
    "                'Income_Level', 'Education_Level', 'Discount_Sensitivity']\n",
    "\n",
    "ordinal_categories = [\n",
    "    ['Low', 'Medium', 'High'],                         \n",
    "    ['Low', 'Medium', 'High'],                          \n",
    "    ['Middle', 'High'],                                 \n",
    "    ['High School', \"Bachelor's\", \"Master's\"],\n",
    "    ['Not Sensitive', 'Somewhat Sensitive', 'Very Sensitive']\n",
    "]\n",
    "\n",
    "ordinal_encoder = OrdinalEncoder(categories=ordinal_categories)\n",
    "e_com_encoded[ordinal_cols] = ordinal_encoder.fit_transform(e_com_encoded[ordinal_cols])\n",
    "\n",
    "joblib.dump(ordinal_encoder, 'ordinal_encoder.pkl')\n",
    "\n",
    "onehot_cols = [\n",
    "    'Gender', 'Marital_Status', 'Occupation', \n",
    "    'Purchase_Category', 'Purchase_Channel',\n",
    "    'Purchase_Intent'\n",
    "]\n",
    "\n",
    "onehot_encoder = OneHotEncoder(drop='first', sparse=False, handle_unknown='ignore')\n",
    "\n",
    "onehot_encoded = onehot_encoder.fit_transform(e_com_encoded[onehot_cols])\n",
    "onehot_df = pd.DataFrame(onehot_encoded, columns=onehot_encoder.get_feature_names_out(onehot_cols), index=e_com_encoded.index)\n",
    "\n",
    "e_com_encoded = pd.concat([e_com_encoded.drop(columns=onehot_cols), onehot_df], axis=1)\n",
    "\n",
    "joblib.dump(onehot_encoder, 'onehot_encoder.pkl')"
   ]
  },
