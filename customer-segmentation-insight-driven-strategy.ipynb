   "source": [
    "for _, row in cluster_summary.iterrows():\n",
    "    cl = row['Cluster']\n",
    "    print(f\"Cluster {cl} (total data={int(row['Count'])}):\")\n",
    "    def fmt(x, fmt_str=\"{:.2f}\"):\n",
    "        return fmt_str.format(x) if pd.notna(x) else \"N/A\"\n",
    "    print(f\"  Age: mean={fmt(row['Age_Mean'], '{:.1f}')},  median={fmt(row['Age_Median'], '{:.1f}')}\")\n",
    "    print(f\"  Purchase Amount: mean=${fmt(row['Purchase_Amount_Mean'])},  median=${fmt(row['Purchase_Amount_Median'])}\")\n",
    "    print(f\"  Frequency_of_Purchase: mean={fmt(row['Frequency_of_Purchase_Mean'])}\")\n",
    "    print(f\"  Brand_Loyalty (avg): {fmt(row['Brand_Loyalty_Mean'])}\")\n",
    "    print(f\"  % Loyalty Program Members: {fmt(row['Loyalty_Member_Pct'], '{:.1f}%')}\")\n",
    "    print(f\"  Gender dominan: {row['Gender_Mode']}\")\n",
    "    print(f\"  Income level dominan: {row['Income_Level_Mode']}\")\n",
    "    print(f\"  Marital status dominan: {row['Marital_Status_Mode']}\")\n",
    "    print(f\"  Education dominan: {row['Education_Level_Mode']}\")\n",
    "    print(f\"  Purchase channel dominan: {row['Purchase_Channel_Mode']}\")\n",
    "    print(f\"  Social media influence (modus): {row['Social_Media_Influence_Mode']}\")\n",
    "    print(f\"  Engagement with Ads (modus): {row['Engagement_with_Ads_Mode']}\")\n",
    "    print(f\"  Purchase intent (modus): {row['Purchase_Intent_Mode']}\")\n",
    "    top3 = e_com_clustered.loc[e_com_clustered['Cluster']==cl, 'Purchase_Category']\\\n",
    "            .value_counts().head(3)\n",
    "    print(\"  Top Purchase Categories (top 3):\")\n",
    "    for cat, cnt in top3.items():\n",
    "        print(f\"    - {cat}: {cnt} customers\")\n",
    "    print(\"-\" * 60)"
   ]
  },
