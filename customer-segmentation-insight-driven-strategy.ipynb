    "mode_df['Status_vs_Intent'] = mode_df['Marital_Status_Mode'] + \" | \" + mode_df['Purchase_Intent_Mode']\n",
    "\n",
    "pivot_df = mode_df.pivot(index='Cluster', columns='Marital_Status_Mode', values='Purchase_Intent_Mode')\n",
    "\n",
    "pivot_df_display = pivot_df.fillna(\"\")\n",
    "\n",
    "plt.figure(figsize=(8,6))\n",
    "sns.heatmap(\n",
    "    pivot_df.notnull(),\n",
    "    annot=pivot_df_display, \n",
    "    fmt='',\n",
    "    cmap='Blues', \n",
    "    cbar=False\n",
    ")\n",
    "\n",
    "plt.title('Marital Status dan Purchase Intent per Cluster Distribution', fontsize=14)\n",
    "plt.xlabel('Marital Status (Modus)')\n",
    "plt.ylabel('Cluster')\n",
    "plt.tight_layout()\n",
    "plt.show()"
