  {
   "cell_type": "code",
   "execution_count": 34,
   "metadata": {},
   "outputs": [],
   "source": [
    "def mode_or_nan(series):\n",
    "    m = series.mode()\n",
    "    return m.iat[0] if not m.empty else np.nan\n",
    "\n",
    "num_cols = ['Age', 'Purchase_Amount', 'Frequency_of_Purchase', 'Brand_Loyalty']\n",
    "for c in num_cols:\n",
    "    if c in e_com_clustered.columns:\n",
    "        e_com_clustered[c] = pd.to_numeric(e_com_clustered[c], errors='coerce')\n",
    "\n",
    "cluster_summary = e_com_clustered.groupby('Cluster').agg(\n",
    "    Count=('Cluster', 'size'),\n",
    "    Age_Mean=('Age', 'mean'),\n",
    "    Age_Median=('Age', 'median'),\n",
    "    Purchase_Amount_Mean=('Purchase_Amount', 'mean'),\n",
    "    Purchase_Amount_Median=('Purchase_Amount', 'median'),\n",
    "    Frequency_of_Purchase_Mean=('Frequency_of_Purchase', 'mean'),\n",
    "    Brand_Loyalty_Mean=('Brand_Loyalty', 'mean'),\n",
    "    Loyalty_Member_Pct=('Customer_Loyalty_Program_Member', lambda x: x.mean()*100),\n",
    "    Gender_Mode=('Gender', mode_or_nan),\n",
    "    Income_Level_Mode=('Income_Level', mode_or_nan),\n",
    "    Marital_Status_Mode=('Marital_Status', mode_or_nan),\n",
    "    Education_Level_Mode=('Education_Level', mode_or_nan),\n",
    "    Occupation_Mode=('Occupation', mode_or_nan),\n",
    "    Purchase_Category_Mode=('Purchase_Category', mode_or_nan),\n",
    "    Purchase_Channel_Mode=('Purchase_Channel', mode_or_nan),\n",
    "    Social_Media_Influence_Mode=('Social_Media_Influence', mode_or_nan),\n",
    "    Discount_Sensitivity_Mode=('Discount_Sensitivity', mode_or_nan),\n",
    "    Engagement_with_Ads_Mode=('Engagement_with_Ads', mode_or_nan),\n",
    "    Purchase_Intent_Mode=('Purchase_Intent', mode_or_nan)\n",
    ").reset_index()"
   ]
