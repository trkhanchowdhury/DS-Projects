   "source": [
    "original_columns = list(e_com.columns)\n",
    "\n",
    "numeric_cols_only = [col for col in numeric_cols if col in e_com_clustered.columns]\n",
    "e_com_clustered[numeric_cols_only] = scaler.inverse_transform(e_com_clustered[numeric_cols_only])\n",
    "\n",
    "if ordinal_cols:\n",
    "    encoded_ordinal = e_com_clustered[ordinal_cols]\n",
    "    if np.issubdtype(encoded_ordinal.dtypes.values[0], np.number):\n",
    "        e_com_clustered[ordinal_cols] = ordinal_encoder.inverse_transform(encoded_ordinal)\n",
    "\n",
    "if onehot_cols:\n",
    "    ohe_feature_names = onehot_encoder.get_feature_names_out(onehot_cols)\n",
    "    existing_ohe_features = [col for col in ohe_feature_names if col in e_com_clustered.columns]\n",
    "    if existing_ohe_features:\n",
    "        nominal_data = e_com_clustered[existing_ohe_features]\n",
    "        decoded_nominal = onehot_encoder.inverse_transform(nominal_data)\n",
    "        decoded_nominal_df = pd.DataFrame(decoded_nominal, columns=onehot_cols, index=e_com_clustered.index)\n",
    "        \n",
    "        e_com_clustered = e_com_clustered.drop(columns=existing_ohe_features)\n",
    "        e_com_clustered = pd.concat([e_com_clustered, decoded_nominal_df], axis=1)\n",
    "\n",
    "cols_order = [col for col in original_columns if col in e_com_clustered.columns]\n",
    "if 'Cluster' in e_com_clustered.columns:\n",
    "    cols_order.append('Cluster')\n",
    "\n",
    "e_com_clustered = e_com_clustered[cols_order]"
   ]
